# MigraTux server settings. Copy to server/.env and change the values.
# Read by docker compose, server/setup.sh and server/migratux.
# Plain KEY=value lines: no spaces, no quotes, no # $ ' " or \ in values.
#
# LAB ONLY: these passwords are served to the clients over plain HTTP during
# the install. Do not reuse real passwords.

# IP address of this server in the client network (ip -4 addr).
SERVER_IP=192.168.0.10
# Network interface that faces the clients (ip -br link), e.g. ens33.
PXE_INTERFACE=ens33
# Port of the HTTP server (installer files, status events, disk images).
HTTP_PORT=8080

# Samba share \\SERVER_IP\SHARE_NAME, one folder per client.
SHARE_NAME=migratux
SMB_USER=migratux
SMB_PASSWORD=ChangeMe-Lab1

# Local admin user created on every migrated Linux PC.
ADMIN_USER=mtxadmin
ADMIN_PASSWORD=ChangeMe-Lab1
# First password of the restored users. They must change it at first login.
USER_PASSWORD=Willkommen1

# Where downloads, backups and disk images go (relative to server/). Needs
# a lot of space: ISO 3 GB + user data + one disk image per client.
DATA_DIR=./data
# Ubuntu ISO to netboot. Empty = newest 24.04 live-server ISO from releases.ubuntu.com.
ISO_URL=
